# Optional AI API keys for enhanced syllabus extraction.
# SyllabusLens works out of the box with its built-in local heuristic parser
# even if neither key is configured.

# Google Gemini API key (recommended — free tier available at https://aistudio.google.com/apikey)
# Supports both text-based and scanned/image-only PDFs natively.
GEMINI_API_KEY=

# Optional: override default Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API key (optional alternative)
OPENAI_API_KEY=

# Optional: override default OpenAI model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
