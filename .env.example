# Optional AI configuration for enhanced syllabus extraction.
# SyllabusLens works out of the box with its built-in layout-aware offline parser
# even if none of these are configured.

# Google Gemini API key (recommended — free tier at https://aistudio.google.com/apikey)
# Uses strict responseSchema + native PDF reading (works on scanned PDFs too).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama LLM (free & 100% offline — https://ollama.com)
# Set OLLAMA_MODEL to auto-enable Ollama in Auto mode, or select Ollama in AI Settings.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# OpenAI API key (optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
